<Window x:Class="HighwayCoaster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HighwayCoaster"
        xmlns:vm="clr-namespace:HighwayCoaster.ViewModels"    
        xmlns:controls="clr-namespace:HighwayCoaster.Controls"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        >
   
    <Window.Resources>
        <vm:LoginPageViewModel x:Key="VM"/>
        <controls:MainMenu x:Key="mvm"/>
    </Window.Resources>
    <Grid DataContext="{Binding Source={StaticResource VM}}" Name="MainGrid">
        <!--<controls:MainMenu x:Name="MM"/>-->
        <Grid.Background>
            <ImageBrush ImageSource="{Binding Background}"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="159"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="148"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.ColumnSpan="2" Margin="27.2,19,114.6,0" Grid.Column="1" Grid.Row="0">
            <Grid.Background>
                <ImageBrush ImageSource="{Binding Logo}" />
            </Grid.Background>
        </Grid>
        <Label Content="USERNAME:" Grid.Row="1" Grid.Column="1" FontFamily="Comic Sans MS Bold" Foreground="Gold"/>
        <Label Content="PASSWORD:" Grid.Row="3" Grid.Column="1" FontFamily="Comic Sans MS Bold" Foreground="Gold"/>
        <TextBox Grid.Column="1" Grid.Row="2" FontSize="18"  />
        <PasswordBox Grid.Column="1" Grid.Row="4" FontSize="18" />
        <Button Content="Login" Margin="139,10,10,110" Grid.Row="5" Grid.Column="1" Background="DarkOrchid" Foreground="Gold" FontFamily="Comic Sans MS Bold" HorizontalAlignment="Stretch" Width="100" />
        
        <Button Content="Register" Margin="10,10,139,110" Grid.Row="5" Grid.Column="1" Background="DarkOrchid" Foreground="Gold" FontFamily="Comic Sans MS Bold" HorizontalAlignment="Stretch" Width="100"/>
        <Button Content="Highscores" Margin="102,10,10,87" Grid.Row="0" Grid.Column="2" Background="DarkOrchid" Foreground="Gold" FontFamily="Comic Sans MS Bold"/>
    </Grid>
</Window>
