<Window x:Class="HighwayCoaster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HighwayCoaster"
        xmlns:Controls="clr-namespace:HighwayCoaster.Controls"
        mc:Ignorable="d"
        Title="HighwayCoaster" Height="450" Width="800" MinWidth="800" MinHeight="450"
        DataContext="{Binding Source={StaticResource Locator}, Path=Main}" >
    <Grid>
        <Grid.Background>
            <VisualBrush>
                <VisualBrush.Visual>
                    <StackPanel Background="White">
                        <MediaElement Source="{Binding Background}" Stretch="Uniform" Volume="0"></MediaElement>
                    </StackPanel>
                </VisualBrush.Visual>
            </VisualBrush>
        </Grid.Background>
        <ContentControl Content="{Binding WindowContent}"/>
    </Grid>
</Window>
