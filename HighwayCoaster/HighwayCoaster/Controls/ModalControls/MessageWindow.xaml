<Window x:Class="HighwayCoaster.Controls.ModalControls.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HighwayCoaster.Controls.ModalControls"
        mc:Ignorable="d"
        Title="MessageWindow" Height="150" Width="400" 
        ResizeMode="NoResize" AllowsTransparency="False" 
        WindowStyle="None" Background="Black" Opacity="0.8" 
        BorderBrush="Gold" BorderThickness="4"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Label Grid.Row="0" x:Name="Label" VerticalAlignment="Center" HorizontalAlignment="Center"   Margin ="5 0 5 0"  FontFamily="Comic Sans MS Bold" Foreground="Gold" Grid.RowSpan="2">
                <AccessText TextWrapping="Wrap" x:Name="Text" TextAlignment="Center">
                </AccessText>
            </Label>
        </Grid>
        <Grid Grid.Row="1">
            <Button x:Name="OkButton" Content="OK" Grid.Column="1" Margin="5 10 5 10" Height="30" Opacity="0.9"  Background="DarkOrchid" Foreground="Gold" FontFamily="Comic Sans MS Bold" />
        </Grid>
    </Grid>
</Window>
