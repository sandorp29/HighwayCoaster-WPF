<UserControl x:Class="HighwayCoaster.Controls.MainMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HighwayCoaster.Controls"
             xmlns:mvm="clr-namespace:HighwayCoaster.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <SolidColorBrush x:Key="TransparentBlack" Color="#000000" Opacity="0.5" />
    </UserControl.Resources>
    <Grid  DataContext="{Binding Source={StaticResource Locator}, Path=Menu}" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center"  Grid.Column="1" Margin="5 10" MaxWidth="300" >
            <Grid Margin ="5 5 5 0" Height="100" >

                <Grid.Background>
                    <ImageBrush ImageSource="{Binding Logo}"/>
                </Grid.Background>
            </Grid>
            <StackPanel Background="{StaticResource TransparentBlack}" Height="254"  Margin="25 10 25 10">
                <Grid Height="252" Margin="0,0,-0.4,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Content="Play" Margin="5 10 5 5" Height="35" Background="DarkOrchid" Foreground="Gold" FontFamily="Comic Sans MS Bold"/>
                    <Button Grid.Row="1" Content="Car Selection" Margin="5 10 5 5" Height="35" Background="DarkOrchid" Foreground="Gold" FontFamily="Comic Sans MS Bold"/>
                    <Button Grid.Row="2" Content="Highscores" Margin="5 10 5 5" Height="35" Background="DarkOrchid" Foreground="Gold" FontFamily="Comic Sans MS Bold"/>
                    <Button Grid.Row="3" Content="Exit" Margin="5 10 5 5" Height="35" Background="DarkOrchid" Foreground="Gold" FontFamily="Comic Sans MS Bold"/>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
