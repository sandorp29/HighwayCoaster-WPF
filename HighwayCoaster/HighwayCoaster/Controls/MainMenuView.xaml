<UserControl x:Class="HighwayCoaster.Controls.MainMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HighwayCoaster.Controls"
             xmlns:mvm="clr-namespace:HighwayCoaster.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <SolidColorBrush x:Key="TransparentBlack" Color="#000000" Opacity="0.5" />
    </UserControl.Resources>
    <Grid  DataContext="{Binding Source={StaticResource Locator}, Path=Menu}" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1.4*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center"  Grid.Column="1" Margin="5 10" MaxWidth="300" >
            <Grid Margin ="5 5 5 0" Height="100" >

                <Grid.Background>
                    <ImageBrush ImageSource="{Binding Logo}"/>
                </Grid.Background>
            </Grid>
            <StackPanel Background="{StaticResource TransparentBlack}" Height="254"  Margin="25 10 25 10">
                <Grid Height="252" Margin="0,0,-0.4,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Opacity="0.75" Content="Play" Margin="5 10 5 5" Height="35" Background="DarkOrchid" Foreground="Gold" FontFamily="Comic Sans MS Bold" Command="{Binding PlayGameCommand}"/>
                    <Button Grid.Row="1" Opacity="0.75" Content="Car Selection" Margin="5 10 5 5" Height="35" Background="DarkOrchid" Foreground="Gold" FontFamily="Comic Sans MS Bold" Command="{Binding CarSelectCommand}"/>
                    <Button Grid.Row="2" Opacity="0.75" Content="Highscores" Margin="5 10 5 5" Height="35" Background="DarkOrchid" Foreground="Gold" FontFamily="Comic Sans MS Bold" Command="{Binding HighscoreCommand}"/>
                    <Button Grid.Row="3" Opacity="0.75" Content="Exit" Margin="5 10 5 5" Height="35" Background="DarkOrchid" Foreground="Gold" FontFamily="Comic Sans MS Bold" Command="{Binding ExitCommand}"/>
                </Grid>
            </StackPanel>
        </StackPanel>
        <Grid Grid.Column="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="3*" MaxWidth="250" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" MaxHeight="100"/>
                <RowDefinition Height="4*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Column="2" Margin="5 5 5 5" Background="{StaticResource TransparentBlack}">
                <Label Content="Resolution:" Margin="10 10 10 0" Foreground="Gold" FontFamily="Comic Sans MS Bold"/>
                <ComboBox Margin="10 5 10 0" Opacity="0.5" ItemsSource="{Binding Path=MainWindowViewModel.Resolutions}" SelectedItem="{Binding Path=MainWindowViewModel.SelectedResolution}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
