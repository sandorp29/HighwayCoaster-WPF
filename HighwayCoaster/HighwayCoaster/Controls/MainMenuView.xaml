<UserControl x:Class="HighwayCoaster.Controls.MainMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HighwayCoaster.Controls"
             xmlns:mvm="clr-namespace:HighwayCoaster.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <mvm:MainMenuViewModel x:Key="MVM"/>
    </UserControl.Resources>
    <Grid DataContext="{Binding Source={StaticResource MVM}}" >
        <Grid.Background>
            <ImageBrush ImageSource="{Binding Background}"/>
        </Grid.Background>
    </Grid>
</UserControl>
